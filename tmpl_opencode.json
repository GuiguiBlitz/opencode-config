{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "azure": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "enabled": true
    },
    "microsoft-learn": {
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp",
      "enabled": true
    },

    "drawio": {
      "type": "local",
      "command": ["npx", "-y", "drawio-mcp-server", "--editor"],
      "enabled": true
    },
    "fabric-core": {
      "type": "remote",
      "url": "https://api.fabric.microsoft.com/v1/mcp/core",
      "enabled": true
    }
  },
  "provider": {
    "llmproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Orange LiteLLM",
      "options": {
        "apiKey": "YOUR_API_KEY",
        "baseURL": "https://llmproxy.ai.orange"
      },
      "models": {
        "vertex_ai/claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "vertex_ai/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5"
        },
        "vertex_ai/claude4-sonnet": {
          "name": "Claude Sonnet 4.0"
        },
        "openai/gpt-5.4": {
          "name": "GPT 5.4"
        },
        "openai/gpt-5.4-mini":{
         "name": "GPT 5.4 mini"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:E2b": {
          "name": "gemma4:E2b (local)"
        }
      }
    }
  },
  "model": "llmproxy/openai/gpt-5.4",
  "skills": {
    "paths": [
      "{env:HOME}/agents/skills"
    ]
  },
  "plugin": ["compound-engineering@git+https://github.com/EveryInc/compound-engineering-plugin.git"]
}
